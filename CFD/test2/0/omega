FoamFile
{
    version 2.0;
    format  ascii;
    class   volScalarField;
    object  omega;
}

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 0.50;

boundaryField
{
    farfield { type freestream; freestreamValue uniform 0.50; }
    airfoil { type omegaWallFunction; value uniform 0.50; }
    frontAndBack { type empty; }
}
