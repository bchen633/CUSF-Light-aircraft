FoamFile
{
    version 2.0;
    format  ascii;
    class   dictionary;
    object  controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      2;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type        forceCoeffs;
        libs        (forces);
        writeControl timeStep;
        writeInterval 1;
        patches     (airfoil);
        rho         rhoInf;
        rhoInf      1;              // kinematic pressure
        CofR        (0.25 0 0);     // quarter chord
        liftDir     (0 1 0);        // alpha = 0
        dragDir     (1 0 0);
        pitchAxis   (0 0 1);
        magUInf     10;
        lRef        1;              // chord [m]
        Aref        0.1;              // chord x z-thickness of YOUR mesh [m2]
    }

    yPlus
    {
        type        yPlus;
        libs        (fieldFunctionObjects);
        writeControl writeTime;
    }

    wallShearStress
    {
        type        wallShearStress;
        libs        (fieldFunctionObjects);
        patches     (airfoil);
        writeControl writeTime;
    }
}
